APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://tripmate:tripmate@postgres:5432/tripmate
REDIS_URL=redis://redis:6379/0
REDIS_PREFIX=tm
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
LLM_TIMEOUT_SECONDS=30
LLM_API_KEY=
HOLD_TTL_SECONDS=600
SHORT_TERM_MEMORY_TTL_SECONDS=604800
IDEMPOTENCY_TTL_SECONDS=604800
ACTION_CONFIRMATION_TTL_SECONDS=900
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=5000
STREAM_BATCH_SIZE=100
MAX_EVENT_ATTEMPTS=5
PENDING_CLAIM_IDLE_MS=30000
STREAM_AUTO_TRIM=false
OTEL_SERVICE_NAME=tripmate-api
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_SAMPLE_RATIO=0.1
RAG_INDEX_ALIAS=tm:knowledge:v1:dev:active
RAG_TOP_K=5
EXTERNAL_HTTP_TIMEOUT_SECONDS=5
AUTH_MODE=signed_bearer
AUTH_SIGNING_SECRET=local-tripmate-signing-secret-change-before-deploy
AGENT_RUN_TIMEOUT_SECONDS=300
MAX_REQUEST_BODY_BYTES=65536
